{
  "name": "dsh-web-brand",
  "version": "0.1.0",
  "description": "Per-server title + favicon branding for dsh web: prefix every browser tab with a brand (Yao - DeepSeek Harness, Yao - <session> - DeepSeek Harness) and swap the favicon, so multiple dsh instances are distinguishable at a glance. Values come from --title/--icon flags, DSH_WEB_BRAND_TITLE/ICON env vars, or the profile cordis.patch.yml row config.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cordis",
    "web",
    "tab",
    "title",
    "favicon",
    "branding",
    "icon"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "import": "./lib/startup.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm pack",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-cmdline": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.2-rc.1",
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
